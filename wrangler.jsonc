{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool25",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      "node_modules/**",
      ".wrangler/**",
      ".DS_Store",
      "Thumbs.db"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
